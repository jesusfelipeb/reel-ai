# ---------------------------------------------------------------------------
# Marca: que tema de themes/*.json se usa. Por defecto "neutral".
# Las escenas animadas pueden pisarlo con su campo "brand"; el pipeline de video
# largo no usa escenas, asi que para ese toma SIEMPRE este valor.
# ---------------------------------------------------------------------------
REEL_BRAND=neutral

# ---------------------------------------------------------------------------
# Lo de abajo solo hace falta para los pipelines con IA (video largo -> 5 shorts).
# El pipeline de video animado solo con texto NO necesita ninguna clave.
# ---------------------------------------------------------------------------

# Clave del proveedor. La unica variable obligatoria.
LLM_API_KEY=

# Proveedor y modelo. Cualquier API compatible con OpenAI sirve.
#
#   Groq (default, rapido y con capa gratis)
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=openai/gpt-oss-120b
#
#   OpenAI
#     LLM_BASE_URL=https://api.openai.com/v1
#     LLM_MODEL=gpt-4.1-mini
#
#   OpenRouter (da acceso a Claude, Gemini y otros con una sola clave)
#     LLM_BASE_URL=https://openrouter.ai/api/v1
#     LLM_MODEL=anthropic/claude-sonnet-4.5
#
#   Ollama (local, sin costo; poné cualquier cosa en LLM_API_KEY)
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_MODEL=llama3.1
#
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Solo para modelos de razonamiento (gpt-oss, serie o de OpenAI): sin esto devuelven
# el JSON cortado. Dejalo vacio si tu proveedor rechaza el parametro.
LLM_REASONING_EFFORT=low

# ---------------------------------------------------------------------------
# Transcripcion (Whisper). Por defecto usa el mismo proveedor que el LLM.
# Descomentá solo si querés transcribir en otro lado.
# ---------------------------------------------------------------------------
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=
STT_MODEL=whisper-large-v3
